rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isRoomMember(roomCode) {
      return signedIn()
        && get(/databases/$(database)/documents/rooms/$(roomCode)).data.players[request.auth.uid] != null;
    }

    function isRoomHost(roomCode) {
      return signedIn()
        && get(/databases/$(database)/documents/rooms/$(roomCode)).data.host == request.auth.uid;
    }

    function isCloverGame(roomCode) {
      return exists(/databases/$(database)/documents/games/$(roomCode))
        && get(/databases/$(database)/documents/games/$(roomCode)).data.gameType == "clover";
    }

    function isRobotrickGame(roomCode) {
      return exists(/databases/$(database)/documents/games/$(roomCode))
        && get(/databases/$(database)/documents/games/$(roomCode)).data.gameType == "robotrick";
    }

    // Games whose hands are secret: only the owner (and the host, for setup/cleanup) may read them.
    function hasPrivateHands(roomCode) {
      return isCloverGame(roomCode) || isRobotrickGame(roomCode);
    }

    // Production dev-feedback mode: only verified emails listed in config/devAccess.emails.
    // That doc is edited by hand in the Firebase console; nobody can write it from the client.
    function isDev() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in get(/databases/$(database)/documents/config/devAccess).data.emails;
    }

    match /config/devAccess {
      allow read: if isDev();
    }

    match /devFeedback/{feedbackId} {
      allow read, create, update, delete: if isDev();

      match /images/{imageId} {
        allow read, create, delete: if isDev();
      }
    }

    // Existing lobby behavior permits signed-in players to discover and join rooms.
    match /rooms/{roomCode} {
      allow read, create, update, delete: if signedIn();
    }

    match /games/{roomCode} {
      // Game state remains collaborative in the current trusted-client architecture.
      allow read, create, update, delete: if isRoomMember(roomCode);

      match /hands/{ownerUid} {
        // Other games currently use collaborative hand documents. Clover boards and Robotrick
        // hands stay private until server-authoritative actions are introduced.
        allow read: if (!hasPrivateHands(roomCode) && isRoomMember(roomCode))
          || (hasPrivateHands(roomCode) && (request.auth.uid == ownerUid || isRoomHost(roomCode)));
        allow create: if (!hasPrivateHands(roomCode) && isRoomMember(roomCode))
          || (hasPrivateHands(roomCode) && isRoomHost(roomCode));
        allow update: if (!hasPrivateHands(roomCode) && isRoomMember(roomCode))
          || (hasPrivateHands(roomCode) && request.auth.uid == ownerUid)
          // Robotrick: the host deals new rounds; any player may deliver a pass, touching only `incoming`.
          || (isRobotrickGame(roomCode) && isRoomHost(roomCode))
          || (isRobotrickGame(roomCode) && isRoomMember(roomCode)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["incoming"]));
        allow delete: if (!hasPrivateHands(roomCode) && isRoomMember(roomCode))
          || (hasPrivateHands(roomCode) && (request.auth.uid == ownerUid || isRoomHost(roomCode)));
      }
    }
  }
}
